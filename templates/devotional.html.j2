{% extends "base.html.j2" %}

{% block title %}{{ metadata.titulo }} | Devocional{% endblock %}
{% block body_class %}study-document devotional-document{% endblock %}

{% block content %}
<main id="conteudo" class="study-page">
  <header class="hero hero--devotional">
    <div class="hero-copy">
      <p class="eyebrow">Devocional · Estudo rápido</p>
      <h1>{{ metadata.titulo }}</h1>
      <p class="hero-lead">{{ metadata.resumo }}</p>
      <div class="hero-meta" aria-label="Dados do estudo">
        <span>{{ metadata.passagem }}</span>
        <span>{{ metadata.traducao }}</span>
        <span>{{ metadata.data }}</span>
        {% if metadata.get("tema") %}<span>{{ metadata.get("tema") }}</span>{% endif %}
      </div>
    </div>
    {% if hero_image %}
    <figure class="hero-figure">
      <img src="{{ hero_image.get('src') }}" alt="{{ hero_image.get('alt') or 'Imagem de apoio ao estudo' }}">
      {% if hero_image.get('legenda') %}<figcaption>{{ hero_image.get('legenda') }}</figcaption>{% endif %}
    </figure>
    {% else %}
    <div class="hero-placeholder" aria-label="Sem imagem de abertura">
      <span>Leitura bíblica guiada</span>
      <small>Conteúdo organizado para leitura e autoexame.</small>
    </div>
    {% endif %}
  </header>

  <div class="study-shell">
    {% if toc %}
    <nav class="toc" aria-label="Índice do devocional">
      <p class="toc-title">Neste estudo</p>
      <div class="toc-list">
        {% for entry in toc %}
        {% if entry.badge_type == "verse" %}
        <a href="#{{ entry.id }}" class="toc-item toc-item--verse"><span class="toc-badge toc-badge--verse">{{ entry.badge }}</span><span class="toc-text">{{ entry.name }}</span></a>
        {% elif entry.is_subitem %}
        <a href="#{{ entry.id }}" class="toc-item toc-item--sub"><span class="toc-badge toc-badge--sub">{{ entry.badge }}</span><span class="toc-text">{{ entry.name }}{% if entry.get("verse_range") %} <small class="toc-range-tag">{{ entry.verse_range }}</small>{% endif %}</span></a>
        {% else %}
        <a href="#{{ entry.id }}" class="toc-item toc-item--section"><span class="toc-badge toc-badge--num">{{ entry.badge }}</span><span class="toc-text">{{ entry.name }}</span></a>
        {% endif %}
        {% endfor %}
      </div>
    </nav>
    {% endif %}

    <article class="study-content">
      <div class="prose study-body">{{ body_html|safe }}</div>
    </article>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div>
        <strong>{{ metadata.titulo }}</strong>
        <span>{{ metadata.passagem }} · {{ metadata.traducao }} · {{ metadata.data }}</span>
      </div>
      {% include "components/credits.html.j2" %}
    </div>
  </footer>
</main>
{% endblock %}
