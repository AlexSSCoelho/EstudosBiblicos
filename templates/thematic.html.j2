{% extends "base.html.j2" %}

{% block title %}{{ metadata.titulo }} | Estudo temático{% endblock %}
{% block body_class %}study-document thematic-document{% endblock %}

{% block content %}
<main id="conteudo" class="study-page">
  <header class="hero hero--thematic{% if not hero_image %} hero--text-only{% endif %}">
    <div class="hero-copy">
      <p class="eyebrow">{{ metadata.tema }}</p>
      <h1>{{ metadata.titulo }}</h1>
      <p class="hero-lead">{{ metadata.resumo }}</p>
      {% if metadata.get("pergunta") %}
      <div class="thematic-question">
        <span class="thematic-question-label">Pergunta central</span>
        <p>{{ metadata.pergunta }}</p>
      </div>
      {% endif %}
      <div class="hero-meta" aria-label="Dados do estudo">
        <span>{{ metadata.traducao }}</span>
        <span class="hero-meta-date">{{ metadata.data | date_br }}</span>
        {% if metadata.get("autor") %}<span>Autor: {{ metadata.get("autor") }}</span>{% endif %}
      </div>
    </div>
    {% if hero_image %}
    <figure class="hero-figure">
      <img src="{{ hero_image.get('src') }}" alt="{{ hero_image.get('alt') or 'Imagem de apoio ao estudo temático' }}" decoding="async">
      {% if hero_image.get('legenda') %}<figcaption>{{ hero_image.get('legenda') }}</figcaption>{% endif %}
    </figure>
    {% endif %}
  </header>

  <div class="study-shell">
    {% include "components/toc.html.j2" %}

    <article class="study-content">
      <div class="prose study-body">{{ body_html|safe }}</div>
    </article>
  </div>

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-meta-primary">
        <strong class="footer-study-title">{{ metadata.titulo }}</strong>
        <span class="footer-study-meta">{{ metadata.tema }} · {{ metadata.traducao }}<span class="footer-meta-date"> · {{ metadata.data | date_br }}</span>{% if metadata.get("autor") %} · {{ metadata.get("autor") }}{% endif %}</span>
      </div>
      {% include "components/credits.html.j2" %}
    </div>
  </footer>
</main>
{% endblock %}
