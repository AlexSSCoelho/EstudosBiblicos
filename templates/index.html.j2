<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#20372a">
  <meta name="description" content="Leituras bíblicas para aprofundar passagens, meditar, estudar temas da fé e consultar pregações.">
  <title>Leituras Bíblicas | Estudos, Devocionais e Pregações</title>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("estudos_theme_v1");
        var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = saved === "dark" || saved === "light" ? saved : (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#111613" : "#20372a");
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="{{ asset_prefix }}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ asset_prefix }}assets/study.css">
  <script defer src="{{ asset_prefix }}assets/study.js"></script>
</head>
<body class="library-page">
  <main id="conteudo" class="library-shell">
    <header class="library-header">
      <div class="library-header-top">
        <p class="eyebrow">Biblioteca de leituras</p>
        <button
          type="button"
          class="theme-toggle-btn"
          id="theme-toggle-btn"
          aria-label="Ativar modo escuro"
          aria-pressed="false"
          title="Alternar modo claro/escuro"
        >
          <svg class="theme-icon theme-icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="theme-icon theme-icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>
      </div>
      <h1>Estudos Bíblicos</h1>
      <p>Escolha entre uma reflexão breve, o estudo de uma passagem, uma investigação temática ou suas pregações.</p>
    </header>

    <section class="library-list" aria-labelledby="library-title">
      <div class="library-list-heading">
        <h2 id="library-title">Encontre o formato certo</h2>
        <span>{{ total_count }} {% if total_count == 1 %}leitura disponível{% else %}leituras disponíveis{% endif %}</span>
      </div>

      <div class="category-cards">
        {% for category in categories %}
        <a class="category-card category-card--{{ category.type }}" href="{{ category.href }}">
          <span class="category-card-kicker">{{ category.kicker }}</span>
          <h3>{{ category.title }}</h3>
          <p>{{ category.description }}</p>
          <span class="category-card-footer">{{ category.count_label }}</span>
        </a>
        {% endfor %}
      </div>

      <p class="library-all-link"><a href="tipos/todas.html">Todas as leituras <span aria-hidden="true">→</span></a></p>
    </section>

    <footer class="library-footer">
      <p>Cada estudo pode ser lido no navegador e também está disponível em PDF.</p>
    </footer>
  </main>
</body>
</html>
