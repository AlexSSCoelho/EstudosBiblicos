{% macro study_card(card, study_prefix) -%}
<article class="study-card study-card--{{ card.tipo }}">
  <div class="card-kicker">{% if card.tipo == "devocional" %}Devocional{% elif card.tipo == "estudo_tematico" %}Estudo temático{% elif card.tipo == "pregacao" %}Pregação{% if card.get("revisao") %} · {{ card.revisao }}{% endif %}{% else %}Estudo expositivo{% endif %}</div>
  <h3><a href="{{ study_prefix }}{{ card.html }}">{{ card.titulo }}</a></h3>
  {% if card.resumo %}<p>{{ card.resumo }}</p>{% endif %}
  {% if card.tipo == "pregacao" %}
    {% if card.passagem or card.tema %}
    <p class="card-reference">{% if card.passagem %}<strong>Passagem:</strong> {{ card.passagem }}{% endif %}{% if card.passagem and card.tema %} · {% endif %}{% if card.tema %}<strong>Tema:</strong> {{ card.tema }}{% endif %}</p>
    {% endif %}
  {% else %}
  <p class="card-reference"><strong>{% if card.tipo == "estudo_tematico" %}Textos bíblicos{% else %}Passagem{% endif %}:</strong> {{ card.passagem }}</p>
  {% endif %}
  <div class="card-footer">
    <div class="card-meta">
      {% if card.tipo == "pregacao" %}
        {% if card.get("igreja") %}<span>{{ card.igreja }}</span>{% endif %}
        {% if card.data_formatada %}<span>Pregada em {{ card.data_formatada }}</span>{% endif %}
        {% if card.get("revisoes_total", 0) > 1 %}<span>{{ card.revisoes_total }} revisões</span>{% endif %}
      {% else %}
        <span>Publicado em {{ card.data_formatada or (card.data | date_br) }}</span>
      {% endif %}
      {% if card.pdf %}<a href="{{ study_prefix }}{{ card.pdf }}" target="_blank" rel="noopener noreferrer">Abrir PDF</a>{% endif %}
    </div>
  </div>
</article>
{%- endmacro %}
