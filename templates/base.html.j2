<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#20372a">
  <meta name="description" content="{{ (metadata.resumo or metadata.titulo) if metadata is defined else 'Biblioteca de estudos bíblicos.' }}">
  <title>{% block title %}Estudos Bíblicos{% endblock %}</title>
  <script>
    (function () {
      try {
        var saved = localStorage.getItem("estudos_theme_v1");
        var prefersDark = window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches;
        var theme = saved === "dark" || saved === "light" ? saved : (prefersDark ? "dark" : "light");
        document.documentElement.setAttribute("data-theme", theme);
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", theme === "dark" ? "#111613" : "#20372a");
      } catch (e) {}
    })();
  </script>
  <link rel="icon" href="{{ asset_prefix }}assets/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="{{ asset_prefix }}assets/study.css">
  <script defer src="{{ asset_prefix }}assets/study.js"></script>
  {% if review_data is defined and review_data %}
  <script defer src="{{ asset_prefix }}assets/review.js"></script>
  {% endif %}
  {% if metadata is defined and metadata.tipo == "pregacao" %}
  <script defer src="{{ asset_prefix }}assets/sermon.js"></script>
  {% endif %}
</head>
<body class="{% block body_class %}{% endblock %}" data-study-type="{{ metadata.tipo if metadata is defined else 'biblioteca' }}">
  <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

  {% if metadata is defined %}
  <header class="topbar">
    <div class="topbar-inner">
      <div class="topbar-left">
        {% if toc is defined and toc %}
        <button
          type="button"
          class="toc-toggle-btn"
          id="toc-toggle-btn"
          aria-label="Recolher índice lateral"
          aria-expanded="true"
          title="Recolher índice lateral"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <line x1="9" y1="4" x2="9" y2="20" />
          </svg>
        </button>
        {% endif %}
        <a class="brand" href="{{ asset_prefix }}" title="Voltar à biblioteca">
          <strong>Estudos Bíblicos</strong>
          <span>· {% if metadata.tipo == "estudo_tematico" %}Estudo temático{% elif metadata.tipo == "pregacao" %}{{ metadata.passagem or "Pregação" }}{% else %}{{ metadata.passagem }}{% endif %}</span>
        </a>
      </div>
      <div class="topbar-actions">
        {% if metadata.tipo == "pregacao" %}
        <button
          type="button"
          class="sermon-auth-btn"
          id="sermon-auth-btn"
          aria-label="Modo autor (anotações e revisões)"
          aria-pressed="false"
          title="Modo autor (anotações e revisões)"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
          </svg>
        </button>
        {% endif %}
        <button
          type="button"
          class="theme-toggle-btn"
          id="theme-toggle-btn"
          aria-label="Ativar modo escuro"
          aria-pressed="false"
          title="Alternar modo claro/escuro"
        >
          <svg class="theme-icon theme-icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          <svg class="theme-icon theme-icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
          </svg>
        </button>
        <a class="pdf-link" href="{{ metadata.id }}.pdf" target="_blank" rel="noopener noreferrer" title="Baixar documento PDF diagramado">
          Baixar PDF
        </a>
        <button type="button" class="print-action" onclick="window.print()" aria-label="Imprimir ou salvar em PDF">
          Imprimir
        </button>
      </div>
    </div>
  </header>
  {% endif %}

  {% block content %}{% endblock %}
</body>
</html>
