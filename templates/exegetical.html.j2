{% extends "base.html.j2" %}

{% block title %}{{ metadata.titulo }} | Estudo exegético{% endblock %}
{% block body_class %}study-document exegetical-document{% endblock %}

{% block content %}
<main id="conteudo" class="study-page">
  <header class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Estudo exegético · Histórico-gramatical</p>
      <h1>{{ metadata.titulo }}</h1>
      <p class="hero-lead">{{ metadata.resumo }}</p>
      <div class="hero-meta" aria-label="Dados do estudo">
        <span>{{ metadata.passagem }}</span>
        <span>{{ metadata.traducao }}</span>
        <span class="hero-meta-date">{{ metadata.data | date_br }}</span>
        {% if metadata.get("autor") %}<span>Autor: {{ metadata.get("autor") }}</span>{% endif %}
        {% if metadata.igreja %}<span>{{ metadata.igreja }}</span>{% endif %}
      </div>
    </div>
    {% if hero_image %}
    <figure class="hero-figure">
      <img src="{{ hero_image.get('src') }}" alt="{{ hero_image.get('alt') or 'Imagem de contexto do estudo' }}">
      {% if hero_image.get('legenda') %}<figcaption>{{ hero_image.get('legenda') }}</figcaption>{% endif %}
    </figure>
    {% else %}
    <div class="hero-placeholder" aria-label="Sem imagem de abertura">
      <span>Contexto histórico e literário</span>
      <small>O estudo prioriza a leitura do texto e seus limites.</small>
    </div>
    {% endif %}
  </header>

  {% if metadata.get("tese") %}
  <div class="thesis-wrap">
    <aside class="thesis" aria-label="Tese da passagem">
      <div class="thesis-inner">
        <span class="thesis-label">Tese da passagem</span>
        <p>{{ metadata.get("tese") }}</p>
      </div>
    </aside>
  </div>
  {% endif %}

  <div class="study-shell{% if review_data %} study-shell--with-rail{% endif %}">
    {% include "components/toc.html.j2" %}

    <article class="study-content">
      <div class="prose study-body">{{ body_html|safe }}</div>
    </article>

    {% if review_data %}
    <aside class="study-rail" id="study-rail" aria-label="Leitura ativa e revisão por seção"></aside>
    {% endif %}
  </div>

  {% if review_data %}
  {% include "components/review-drawer.html.j2" %}
  <script type="application/json" id="study-review-data">{{ review_json|safe }}</script>
  {% endif %}

  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-meta-primary">
        <strong class="footer-study-title">{{ metadata.titulo }}</strong>
        <span class="footer-study-meta">{{ metadata.passagem }} · {{ metadata.traducao }}<span class="footer-meta-date"> · {{ metadata.data | date_br }}</span>{% if metadata.igreja %} · {{ metadata.igreja }}{% endif %}</span>
      </div>
      {% include "components/credits.html.j2" %}
    </div>
  </footer>
</main>
{% endblock %}
